# Frank-XMD environment configuration
# Copy this file to .env and replace placeholders with your own credentials.
# Never commit .env or paste real tokens into public repositories.

# Telegram BotFather token (required for Telegram sticker-pack import commands)
TELEGRAM_BOT_TOKEN=

# Giphy developer API key (required for .gif search)
GIPHY_API_KEY=

# African-language text-to-speech (required for Swahili, Kikuyu and Luo)
KHAYA_API_KEY=

# Kikamba text-to-speech (Gemini API key)
GEMINI_API_KEY=
 
# Optional media and AI provider credentials. Leave blank if unused.
KNIGHT_API_KEY=
MEDIA_API_KEY=
PRINCE_API_KEY=
